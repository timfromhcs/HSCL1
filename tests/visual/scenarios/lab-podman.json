[
  { "wait": 10 },
  { "keys": ["meta_l"] },
  { "wait": 4 },
  { "type": "Konsole" },
  { "wait": 3 },
  { "keys": ["ret"] },
  { "wait": 14 },
  { "type": "hscl lab status | head -8; echo ---; hscl dev status | head -12" },
  { "keys": ["ret"] },
  { "wait": 6 },
  { "shot": "l1-before" },
  { "type": "sudo apt-get update -qq 2>&1 | tail -2; sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq podman 2>&1 | tail -3" },
  { "keys": ["ret"] },
  { "wait": 180 },
  { "shot": "l2-install" },
  { "type": "podman --version; grep -c . /etc/subuid /etc/subgid 2>&1; id -un" },
  { "keys": ["ret"] },
  { "wait": 5 },
  { "shot": "l3-runtime" },
  { "type": "podman run --rm docker.io/library/busybox:latest echo ROOTLESS_OK > /tmp/pr.log 2>&1; kdialog --title podman --msgbox \"$(tail -3 /tmp/pr.log)\"" },
  { "keys": ["ret"] },
  { "wait": 120 },
  { "shot": "l4-rootless-run" },
  { "keys": ["ret"] },
  { "wait": 2 },
  { "type": "podman info --format '{{.Host.Security.Rootless}} {{.Host.CgroupVersion}}' > /tmp/pi.log 2>&1; kdialog --title info --msgbox \"$(cat /tmp/pi.log)\"" },
  { "keys": ["ret"] },
  { "wait": 15 },
  { "shot": "l5-rootless-info" },
  { "keys": ["ret"] }
]
