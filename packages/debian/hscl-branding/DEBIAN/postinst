#!/bin/sh
# Assemble the HSCL1 Plymouth theme and make it the default. The generic dialog artwork (entry, bullet, lock, keyboard, capslock,
# the .script) is taken from the base theme when it is installed; if it is not, the default is left untouched.
set -e
if [ "$1" = configure ]; then
  base=/usr/share/plymouth/themes/kubuntu-logo
  new=/usr/share/plymouth/themes/hscl1-logo
  gen=/usr/share/hscl/plymouth
  if [ -d "$base" ] && [ -f "$gen/hscl1-logo.plymouth" ] && command -v update-alternatives >/dev/null 2>&1; then
    rm -rf "$new"
    cp -a "$base" "$new"
    # drop every branded file of the base theme (names, logo frames, preview, source art, GRUB variant, readme, script); the theme uses the two-step module and needs no script
    rm -f "$new"/throbber-*.png "$new"/throbber.xcf "$new"/watermark.png "$new"/progress-00.png "$new"/preview.png \
          "$new"/README.md "$new"/kubuntu-logo.*
    cp "$gen"/*.png "$gen/hscl1-logo.plymouth" "$new"/
    update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
      "$new/hscl1-logo.plymouth" 200
    update-alternatives --set default.plymouth "$new/hscl1-logo.plymouth"
  fi
fi
# Menu sections live in /etc/xdg/menus/applications-merged and are only visible once KDE has
# rebuilt its cache. Plasma finds them because startplasma sets XDG_MENU_PREFIX=plasma- and the base
# menu carries <DefaultMergeDirs/> (checked against kservice and plasma-workspace sources, 2026-11-07);
# without a rebuild a freshly installed section can stay invisible until the next login, which looks
# exactly like a broken menu file. Rebuild as the invoking desktop user when we can: a root-owned
# cache in /root would be useless and would shadow nothing.
if [ "$1" = configure ] && command -v kbuildsycoca6 >/dev/null 2>&1; then
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && command -v runuser >/dev/null 2>&1; then
    runuser -u "$SUDO_USER" -- kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
  elif [ -n "${PKEXEC_UID:-}" ] && command -v runuser >/dev/null 2>&1; then
    runuser -u "$(id -un "$PKEXEC_UID" 2>/dev/null || echo nobody)" -- kbuildsycoca6 --noincremental >/dev/null 2>&1 || true
  fi
fi
exit 0
