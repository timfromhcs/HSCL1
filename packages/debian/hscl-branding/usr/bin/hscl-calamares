#!/bin/sh
# HSCL1 installer launcher.
#
# Two independent problems were measured on QEMU/WHPX:
#
# 1. The welcome module's `internet` check made an HTTPS request inside the requirement phase and crashed
#    Calamares there; it is removed from `welcome.conf` by the image hook.
# 2. Even without that, the installer dies in roughly one start in six while it builds its first page, whoever
#    starts it. Measured 2026-11-11 on `HSCL1-rc4`, 10 starts in one boot: 4 up / 1 dead, 4 up / 1 dead - the
#    second series with `QT_QPA_PLATFORM=xcb`, so the platform plugin is not the cause (see BUILD_LOG). The
#    journal always looks the same: `KCrash: Application 'calamares' crashing... crashRecursionCounter = 2`,
#    drkonqi starts, then `line 16: <pid> Killed calamares -D8`. The crash-handler dialog then covers the
#    screen and the user is left with a dead wizard.
#
#    Measured 2026-11-12 (queue row Q-68) and worth knowing before reading those logs again:
#      * the signal is an ABORT, not a fault - `dmesg` has no `segfault`/`traps` line for nine deaths, and
#        SIGSEGV/SIGBUS/SIGILL/SIGFPE all log one;
#      * `crashRecursionCounter = 2` is the NORMAL value for a first crash (KCrash increments twice before it
#        prints), so it does not mean the handler failed twice;
#      * `KCrash: appFilePath points to nullptr!` / `Application '<unknown>' crashing` comes from a SECOND
#        process with a different pid - the forked drkonqi, i.e. the broken crash reporter, not calamares;
#      * the rate depends on the environment by a factor of eight: 1 death in 12 starts as shipped, 8 in 12
#        with `QT_QPA_PLATFORMTHEME` and `XDG_CURRENT_DESKTOP` cleared. Do NOT "clean up" those variables
#        here; the shipped environment is the one that mostly works.
#
# Software rendering removes the GPU timing from the picture but does not remove the fault, so this wrapper
# restarts the installer when it dies from a signal **within the first minute** - that is the measured failure
# window (it dies while building the first page, before it writes anything). A crash later than that is passed
# through, because restarting over a half-written disk would be worse than stopping. A normal exit - installed,
# cancelled, window closed - is passed through untouched, and after three early deaths the wrapper gives up
# instead of looping forever.
#
# `KCRASH_DUMP_ONLY=1` is meant to stop KCrash from spawning drkonqi (KCrash::initialize() disables drkonqi when it
# is set), and drkonqi is what puts the broken crash-handler dialog over the wizard. **Measured 2026-11-12: it does
# not stop the fault in this image.** Six direct starts with the variable set still ended in exit 137 twice, exactly
# like six without it, and `kernel.core_pattern=/tmp/cores/core.%e.%p` plus `ulimit -c unlimited` produced zero cores
# in either series (artifacts/q61-core). So this export stays as a precaution, NOT as the mitigation: what actually
# makes an install succeed is the restart loop below. The SIGKILL was traced to drkonqi by an audit rule on kill(2)
# (artifacts/q61-audit2); that run did not set this variable, so whether drkonqi still runs with it set is unmeasured.
# Do not describe this line as a fix without that measurement.
export QT_QUICK_BACKEND=software
export LIBGL_ALWAYS_SOFTWARE=1
export KCRASH_DUMP_ONLY=1

LOG=/tmp/hscl-calamares.log
attempt=1
while [ "$attempt" -le 3 ]; do
  started=$(date +%s)
  /usr/bin/calamares-launch-normal "$@"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    exit 0
  fi
  elapsed=$(( $(date +%s) - started ))
  case "$rc" in
    87)
      # Calamares refuses to run a second instance with exit 87. After a crash the previous process can still
      # hold that lock for a moment, so a restart that arrives too early would otherwise be thrown away.
      echo "hscl-calamares: attempt $attempt hit the single-instance lock (87) after ${elapsed}s, retrying" >>"$LOG" 2>&1
      attempt=$((attempt + 1))
      sleep 5
      continue
      ;;
    134|135|136|137|139|143)
      if [ "$elapsed" -le 60 ]; then
        echo "hscl-calamares: attempt $attempt died from a signal after ${elapsed}s (exit $rc), restarting" >>"$LOG" 2>&1
        attempt=$((attempt + 1))
        sleep 2
        continue
      fi
      echo "hscl-calamares: died from a signal after ${elapsed}s (exit $rc); not restarting an install in progress" >>"$LOG" 2>&1
      exit "$rc"
      ;;
  esac
  echo "hscl-calamares: attempt $attempt exited with $rc after ${elapsed}s (not a crash), giving up" >>"$LOG" 2>&1
  exit "$rc"
done
echo "hscl-calamares: the installer died three times early; see $LOG" >>"$LOG" 2>&1
exit 1
