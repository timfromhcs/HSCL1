#!/bin/sh
# Give the freshly created account an avatar that SDDM can actually read (Q-44 / Q-75).
#
# Why this exists: Calamares creates the user but nothing writes an AccountsService entry, so the greeter falls
# back to the KDE gear. The obvious fix - Icon=/home/<user>/.face.icon - does not work: the installed home is
# 0750, so the greeter user (sddm) cannot traverse it. The HSCL1 mark below is world-readable and the same
# artwork the skel .face already contains; a user who picks their own avatar later overrides this entry through
# AccountsService/Plasma.
#
# Runs as a Calamares shellprocess right after the `users` module, inside the target chroot.
set -eu

icon=/usr/share/hscl/brand/hscl1-mark-256.png
[ -f "$icon" ] || exit 0

for home in /home/*; do
    [ -d "$home" ] || continue
    user=$(basename "$home")
    case "$user" in
        lost+found) continue ;;
    esac
    id "$user" >/dev/null 2>&1 || continue
    uid=$(id -u "$user")
    # Human accounts only: system users live below 1000, and nobody lives above 60000.
    [ "$uid" -ge 1000 ] || continue
    [ "$uid" -lt 60000 ] || continue

    # AccountsService entry (read by KCM User Manager / GNOME):
    dir=/var/lib/AccountsService/users
    mkdir -p "$dir"
    tmp="$dir/.$user.tmp"
    {
        echo "[User]"
        echo "Icon=$icon"
        echo "SystemAccount=false"
    } > "$tmp"
    chmod 0600 "$tmp"
    mv "$tmp" "$dir/$user"

    # SDDM user avatar (SDDM reads /usr/share/sddm/faces/<user>.face.icon):
    sddm_faces=/usr/share/sddm/faces
    if [ -d "$sddm_faces" ]; then
        cp -f "$icon" "$sddm_faces/$user.face.icon"
        chmod 0644 "$sddm_faces/$user.face.icon"
    fi
done

exit 0
