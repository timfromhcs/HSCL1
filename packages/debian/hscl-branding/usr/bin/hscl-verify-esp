#!/bin/sh
# Fail the Calamares install when the EFI system partition carries no boot loader.
#
# Measured 2026-11-11 on an rc10 install: the installer reported "All done" and wrote the kernel plus /boot/grub,
# but the ESP (`vda1`, FAT32) and `/boot/efi` inside the new root were both **empty**. The firmware then fell back
# to its UEFI shell (`Shell>`) and the system never booted - nothing in the summary said so. AppArmor, firewall,
# LUKS and every other check looked fine; only the boot chain was missing.
#
# This script runs right after Calamares' `bootloader` module (shellprocess, inside the target chroot) and turns
# that silent failure into a visible one: a non-zero exit makes Calamares stop with an error page instead of
# telling the user the installation succeeded.
#
# The cause of the empty ESP is still unknown (queue row Q-66), so the failure path also prints the state that
# discriminates the two remaining hypotheses:
#
#   * ESP not mounted at /boot/efi  -> the mount/partition module lost it, grub-install wrote into the root
#                                     filesystem instead (then /boot/efi would not be empty - so this shows up
#                                     as "mountpoint missing" plus a populated /boot/efi)
#   * ESP mounted, no loader written -> the bootloader module reported success without copying anything
#
# Without this, a recurrence only ever says "no loader", which is the symptom, not the cause.
set -eu
efi="${HSCL_ESP:-/boot/efi}"
# The GRUB and /boot paths are overridable for the same reason as the ESP: the script runs inside the target
# chroot, where the defaults are correct, but a test that executes it on a normal host must be able to point it
# at an empty directory - otherwise the host's own /boot/grub/i386-pc makes the legacy branch fire and the
# negative test passes for the wrong reason (caught by CI on PR #62, 2026-11-12).
grub="${HSCL_GRUB:-/boot/grub}"
boot="${HSCL_BOOT:-/boot}"

# diagnose: everything that separates "not mounted" from "mounted but empty". Read-only, never fails.
diagnose() {
  echo "hscl-verify-esp: --- diagnostics (Q-66) ---" >&2
  if command -v findmnt >/dev/null 2>&1; then
    echo "hscl-verify-esp: findmnt $efi: $(findmnt -no SOURCE,TARGET,FSTYPE,OPTIONS --target "$efi" 2>&1 || echo 'not a mountpoint')" >&2
  fi
  echo "hscl-verify-esp: efi mount entries in /proc/mounts:" >&2
  grep -i -E 'efi|vfat' /proc/mounts 2>/dev/null | sed 's/^/hscl-verify-esp:   /' >&2 || echo "hscl-verify-esp:   (none)" >&2
  echo "hscl-verify-esp: ls -la $efi:" >&2
  ls -la "$efi" 2>&1 | sed 's/^/hscl-verify-esp:   /' >&2 || true
  echo "hscl-verify-esp: grub modules under $grub: $(ls "$grub" 2>/dev/null | wc -l) entries" >&2
  echo "hscl-verify-esp: kernel images in $boot: $(ls "$boot"/vmlinuz-* 2>/dev/null | wc -l)" >&2
  # The `logs` module may already have copied the installer log into the target; it names what grub-install said.
  for f in /var/log/Installation /var/log/calamares.log; do
    [ -f "$f" ] || continue
    echo "hscl-verify-esp: tail of $f:" >&2
    tail -n 20 "$f" 2>&1 | sed 's/^/hscl-verify-esp:   /' >&2 || true
  done
  echo "hscl-verify-esp: --- end diagnostics ---" >&2
}

if [ ! -d "$efi/EFI" ]; then
  # A legacy/BIOS install has no EFI system partition and is not supposed to have one: `grub-install --target=i386-pc`
  # writes /boot/grub/i386-pc and puts the boot image on the disk's MBR gap instead. The check must not fail such an
  # install - it would turn "you booted the ISO in BIOS mode" into "the installation is broken".
  if [ -d "$grub/i386-pc" ]; then
    echo "hscl-verify-esp: legacy (BIOS) install - $grub/i386-pc present, no ESP expected; check does not apply"
    exit 0
  fi
  echo "hscl-verify-esp: $efi/EFI is missing - the installer did not populate the EFI system partition" >&2
  diagnose
  exit 1
fi

if [ -f "$efi/EFI/BOOT/BOOTX64.EFI" ]; then
  echo "hscl-verify-esp: removable loader EFI/BOOT/BOOTX64.EFI present"
  exit 0
fi

for loader in "$efi"/EFI/*/grubx64.efi; do
  if [ -f "$loader" ]; then
    echo "hscl-verify-esp: loader $loader present"
    exit 0
  fi
done

echo "hscl-verify-esp: no BOOTX64.EFI and no grubx64.efi under $efi/EFI - the installed system would not boot" >&2
diagnose
exit 1
