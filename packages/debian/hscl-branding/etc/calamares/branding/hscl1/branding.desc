---
componentName: hscl1

windowExpanding:    normal
windowSize:         1100px,640px
windowPlacement:    center
# Fullscreen put the 36 px top bar on top of the branding sidebar and clipped the logo
# (visual QA 2026-11-09, docs/img/showcase/11_installer_welcome.png). 1100x640 stays clear of the
# dock on the smallest supported screen (1366x768) and keeps the bar visible.
welcomeExpandingLogo: true

strings:
    productName:         HSCL1
    shortProductName:    HSCL1
    version:             0.1.6-alpha.0
    shortVersion:        0.1.6-alpha.0
    versionedName:       HSCL1 0.1.6-alpha.0
    shortVersionedName:  HSCL1 0.1.6-alpha.0
    bootloaderEntryName: HSCL1
    productUrl:          https://github.com/timfromhcs
    supportUrl:          https://github.com/timfromhcs

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"

slideshowAPI:            1

style:
   SidebarBackground:    "#151a23"
   SidebarText:          "#e8ecf3"
   SidebarTextCurrent:   "#6c8cff"
