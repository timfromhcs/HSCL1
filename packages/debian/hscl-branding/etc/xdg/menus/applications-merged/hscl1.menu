<!DOCTYPE Menu PUBLIC "-//freedesktop//DTD Menu 1.0//EN" "http://www.freedesktop.org/standards/menu-spec/menu-1.0.dtd">
<!-- HSCL1 launcher sections. Read by KDE from /etc/xdg/menus/applications-merged/.
     Categories are the freedesktop main categories from AGENTS.md 4.2 that have real desktop
     entries today: Development, Internet, Office, Graphics, Multimedia (AudioVideo), System.
     "Favorites" is a launcher feature, not a menu section. "Security Lab" and "Privacy" are
     deliberately absent: HSCL1 ships no desktop entries for them yet, and an empty section is a
     button that does nothing (see docs/KNOWN_LIMITATIONS.md). Add them together with the entries.

     IMPORTANT (visual QA 2026-11-09): a <Menu> is merged with the base menu by its *default* <Name>.
     Localised <Name xml:lang=".."> children made KDE treat these as separate menus, so the launcher
     showed "Development" next to "Développement" and "Graphics" next to "Graphisme". The translated
     titles now live in the .directory files under /usr/share/desktop-directories/ (XDG way). -->
<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>Development</Name>
    <Directory>hscl-development.directory</Directory>
    <Include>
      <Category>Development</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>Internet</Name>
    <Directory>hscl-internet.directory</Directory>
    <Include>
      <Category>Network</Category>
    </Include>
    <Include>
      <And>
        <Category>Network</Category>
        <Category>WebBrowser</Category>
      </And>
    </Include>
  </Menu>
  <Menu>
    <Name>Office</Name>
    <Directory>hscl-office.directory</Directory>
    <Include>
      <Category>Office</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>Graphics</Name>
    <Directory>hscl-graphics.directory</Directory>
    <Include>
      <Category>Graphics</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>Multimedia</Name>
    <Directory>hscl-multimedia.directory</Directory>
    <Include>
      <Category>AudioVideo</Category>
    </Include>
  </Menu>
  <Menu>
    <Name>System</Name>
    <Directory>hscl-system.directory</Directory>
    <Include>
      <Category>System</Category>
    </Include>
    <Include>
      <Category>Settings</Category>
    </Include>
    <Include>
      <Category>Utility</Category>
    </Include>
  </Menu>
</Menu>
