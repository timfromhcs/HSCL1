#!/bin/sh
set -e
# The kdeconnect package owns this file; divert it so our hidden copy wins and upgrades of kdeconnect do not overwrite it.
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  dpkg-divert --package hscl-security --quiet --rename --divert /etc/xdg/autostart/org.kde.kdeconnect.daemon.desktop.kdeconnect --add /etc/xdg/autostart/org.kde.kdeconnect.daemon.desktop
  dpkg-divert --package hscl-security --quiet --rename --divert /usr/share/dbus-1/services/org.kde.kdeconnect.service.kdeconnect --add /usr/share/dbus-1/services/org.kde.kdeconnect.service
fi
