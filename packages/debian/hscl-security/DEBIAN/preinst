#!/bin/sh
set -e
# The kdeconnect package owns these files; divert the originals OUT of the scanned directories (a diverted copy left in
# /etc/xdg/autostart is still started by systemd-xdg-autostart-generator - seen in a VM run).
if [ "$1" = install ] || [ "$1" = upgrade ]; then
  mkdir -p /usr/share/hscl/diverted
  dpkg-divert --package hscl-security --quiet --rename --divert /usr/share/hscl/diverted/org.kde.kdeconnect.daemon.desktop --add /etc/xdg/autostart/org.kde.kdeconnect.daemon.desktop
  dpkg-divert --package hscl-security --quiet --rename --divert /usr/share/hscl/diverted/org.kde.kdeconnect.service --add /usr/share/dbus-1/services/org.kde.kdeconnect.service
fi
