{
  "$schema": "https://hscl1.invalid/schema/tokens-v1.json",
  "name": "HSCL1 design tokens",
  "credit": "Made with love by hcsmedia",
  "themes": {
    "hcs-midnight": {
      "surface-0": "#0e1117", "surface-1": "#151a23", "surface-2": "#1d2430", "surface-glass": "#1d2430cc",
      "text-primary": "#e8ecf3", "text-secondary": "#b4bdcc", "text-muted": "#8a94a6", "text-inverse": "#0e1117",
      "accent": "#6c8cff", "accent-hover": "#8aa3ff", "accent-pressed": "#5573e6", "accent-soft": "#6c8cff26",
      "success": "#3ecf8e", "warning": "#f5b83d", "danger": "#ff6b6b", "info": "#5cc8ff",
      "border-subtle": "#2a3342", "border-strong": "#3d485c", "focus-ring": "#9db4ff"
    },
    "hcs-light": {
      "surface-0": "#f6f5f2", "surface-1": "#ffffff", "surface-2": "#eceff4", "surface-glass": "#ffffffcc",
      "text-primary": "#141821", "text-secondary": "#3b4455", "text-muted": "#5b6577", "text-inverse": "#ffffff",
      "accent": "#3a5bd9", "accent-hover": "#2f4cc0", "accent-pressed": "#263fa3", "accent-soft": "#3a5bd91f",
      "success": "#17794f", "warning": "#8a5a00", "danger": "#c0392b", "info": "#0b6e99",
      "border-subtle": "#d6dbe4", "border-strong": "#aab3c2", "focus-ring": "#3a5bd9"
    }
  },
  "radius": { "sm": 4, "md": 8, "lg": 12, "xl": 18, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64 },
  "shadow": {
    "low": "0 1px 2px rgba(0,0,0,.25)",
    "floating": "0 8px 24px rgba(0,0,0,.35)",
    "dialog": "0 16px 48px rgba(0,0,0,.5)"
  },
  "typography": {
    "family": "Inter, Noto Sans, system-ui, sans-serif",
    "mono": "JetBrains Mono, Noto Sans Mono, monospace",
    "scale": { "xs": 12, "sm": 13, "md": 15, "lg": 18, "xl": 24, "2xl": 32, "3xl": 44 },
    "line-height": { "tight": 1.2, "normal": 1.5, "relaxed": 1.65 }
  },
  "motion": {
    "duration-fast": 120, "duration-base": 200, "duration-slow": 320,
    "easing-standard": "cubic-bezier(0.2, 0, 0, 1)", "easing-emphasized": "cubic-bezier(0.3, 0, 0, 1.2)"
  }
}
