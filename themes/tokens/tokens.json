  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 18,
    "pill": 999
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64
  },
  "shadow": {
    "low": "0 1px 2px rgba(0,0,0,.25)",
    "floating": "0 8px 24px rgba(0,0,0,.35)",
    "dialog": "0 16px 48px rgba(0,0,0,.5)"
  },
  "typography": {
    "family": "Inter, Noto Sans, system-ui, sans-serif",
    "mono": "JetBrains Mono, Noto Sans Mono, monospace",
    "scale": {
      "xs": 12,
      "sm": 13,
      "md": 15,
      "lg": 18,
      "xl": 24,
      "2xl": 32,
      "3xl": 44
    },
    "line-height": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.65
    }
  },
  "motion": {
    "duration-fast": 120,
    "duration-base": 200,
    "duration-slow": 320,
    "easing-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "easing-emphasized": "cubic-bezier(0.3, 0, 0, 1.2)"
  }
