[Unit]
Description=HSCL1 security baseline (firewall)
ConditionPathExists=!/var/lib/hscl/security-baseline.done
After=network-pre.target
Before=network.target

[Service]
Type=oneshot
ExecStart=/usr/lib/hscl/security-baseline.sh
RemainAfterExit=yes
# Sandbox, measured with systemd-analyze security in a booted VM: exposure 7.6 -> 2.5 with all of the following, and the unit still
# applies the ufw policy (docs/CLAIMS.md). Paths are optional ("-") because their existence differs between images; the state
# directory /var/lib/hscl is created by StateDirectory=.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RemoveIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
ReadWritePaths=-/etc/default/ufw -/etc/ufw -/var/lib/ufw -/lib/ufw -/var/log -/run
StateDirectory=hscl

[Install]
WantedBy=multi-user.target
