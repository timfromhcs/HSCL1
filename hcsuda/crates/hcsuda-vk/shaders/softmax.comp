#version 450

// Numerically stable softmax over one row: one workgroup per row, 256 lanes,
// tree reduction in shared memory.
//
// Push constants: { uint cols; uint rows; }
// Bindings: 0 = x (read), 1 = y (write)
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer XBuf { float x[]; };
layout(std430, binding = 1) writeonly buffer YBuf { float y[]; };

layout(push_constant) uniform Push {
    uint cols;
    uint rows;
} pc;

shared float scratch[256];

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.rows) {
        return;
    }
    uint tid = gl_LocalInvocationID.x;
    uint base = row * pc.cols;

    // 1. row maximum, so exp() cannot overflow
    float local_max = -3.402823466e+38;
    for (uint c = tid; c < pc.cols; c += 256u) {
        local_max = max(local_max, x[base + c]);
    }
    scratch[tid] = local_max;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            scratch[tid] = max(scratch[tid], scratch[tid + s]);
        }
        barrier();
    }
    float row_max = scratch[0];

    // 2. sum of exp(x - max)
    float local_sum = 0.0;
    for (uint c = tid; c < pc.cols; c += 256u) {
        local_sum += exp(x[base + c] - row_max);
    }
    scratch[tid] = local_sum;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (tid < s) {
            scratch[tid] += scratch[tid + s];
        }
        barrier();
    }
    float inv = 1.0 / scratch[0];

    // 3. normalise
    for (uint c = tid; c < pc.cols; c += 256u) {
        y[base + c] = exp(x[base + c] - row_max) * inv;
    }
}
