#version 450

// a = b + alpha * c
//
// Push constants: { float alpha; uint n; }
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) writeonly buffer ABuf { float a[]; };
layout(std430, binding = 1) readonly buffer BBuf { float b[]; };
layout(std430, binding = 2) readonly buffer CBuf { float c[]; };

layout(push_constant) uniform Push {
    float alpha;
    uint n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) {
        return;
    }
    a[i] = b[i] + pc.alpha * c[i];
}
