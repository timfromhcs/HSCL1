#version 450

// y = alpha * x + y
//
// Push constants must match `PushAlphaN` in the CLI byte for byte:
//   layout(push_constant) { float alpha; uint n; }
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer XBuf { float x[]; };
// `y` is read *and* written, so it must not be declared writeonly.
layout(std430, binding = 1) buffer YBuf { float y[]; };

layout(push_constant) uniform Push {
    float alpha;
    uint n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) {
        return;
    }
    y[i] = pc.alpha * x[i] + y[i];
}
