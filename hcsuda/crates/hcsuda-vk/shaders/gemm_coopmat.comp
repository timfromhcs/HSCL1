#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Cooperative-matrix GEMM: C = A * B with f16 inputs and f32 accumulation.
//
// One workgroup = one subgroup (64 invocations on the Radeon 680M) computes one
// 16x16 output tile by walking k in steps of 16 with coopMatMulAdd. The shape
// 16x16x16 f16*f16->f32 at subgroup scope is one the device reports
// (`hcsuda coopmat`). A and B are the same packed-half buffers the f16 tiled
// kernel reads: little-endian halves are simply a float16_t array.
//
// Requires m, n, k all multiples of 16 (the host refuses other shapes; the
// planner only selects this path for them).
//
// Push constants: { uint m; uint n; uint k; }
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ABuf { float16_t a[]; };
layout(std430, binding = 1) readonly buffer BBuf { float16_t b[]; };
layout(std430, binding = 2) writeonly buffer CBuf { float c[]; };

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
} pc;

void main() {
    uint tile_col = gl_WorkGroupID.x;
    uint tile_row = gl_WorkGroupID.y;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (uint kk = 0u; kk < pc.k; kk += 16u) {
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma;
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb;
        coopMatLoad(ma, a, tile_row * 16u * pc.k + kk, pc.k, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb, b, kk * pc.n + tile_col * 16u, pc.n, gl_CooperativeMatrixLayoutRowMajor);
        acc = coopMatMulAdd(ma, mb, acc);
    }

    coopMatStore(acc, c, tile_row * 16u * pc.n + tile_col * 16u, pc.n,
                 gl_CooperativeMatrixLayoutRowMajor);
}
