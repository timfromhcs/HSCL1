#version 450
#extension GL_EXT_integer_dot_product : require

// Signed int8 matrix product with int32 accumulation: C = A * B.
//
// A is m x k, packed four int8 per uint along k (row-major, k/4 words per row).
// B is supplied TRANSPOSED (n x k) and packed the same way, so both operands of
// each dot product are contiguous words. Needs k % 4 == 0.
// One invocation per output element, k/4 dotPacked4x8EXT steps. Integer
// accumulation is exact, so the differential test demands bit equality.
//
// Push constants: { uint m; uint n; uint k; }
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ABuf { int a[]; };
layout(std430, binding = 1) readonly buffer BBuf { int bt[]; };
layout(std430, binding = 2) writeonly buffer CBuf { int c[]; };

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
} pc;

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= pc.m || col >= pc.n) {
        return;
    }
    uint words = pc.k / 4u;
    int acc = 0;
    for (uint i = 0u; i < words; ++i) {
        acc += dotPacked4x8EXT(a[row * words + i], bt[col * words + i]);
    }
    c[row * pc.n + col] = acc;
}
