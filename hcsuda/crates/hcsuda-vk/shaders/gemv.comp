#version 450

// Row-major matrix-vector product: y = A * x, A is rows x cols.
//
// One invocation per output row. Each row is reduced sequentially inside the
// invocation, which keeps the reduction order identical to the CPU oracle and
// therefore makes the f32 differential test meaningful. The tiled and
// cooperative-matrix variants (H2) are separate shaders with their own
// tolerance and their own evidence.
//
// Push constants: { uint rows; uint cols; }
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ABuf { float a[]; };
layout(std430, binding = 1) readonly buffer XBuf { float x[]; };
layout(std430, binding = 2) writeonly buffer YBuf { float y[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint cols;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.rows) {
        return;
    }
    float acc = 0.0;
    uint base = row * pc.cols;
    for (uint c = 0; c < pc.cols; ++c) {
        acc += a[base + c] * x[c];
    }
    y[row] = acc;
}
