{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcsmedia.github.io/schemas/hcs.miner.ack.v1.json",
  "title": "HCS Miner Batch Acknowledgement v1",
  "type": "object",
  "description": "Receiver acknowledgement for a batch upload. Confirms durable commit of events up to ack_sequence.",
  "required": [
    "schema",
    "receiver_id",
    "device_id",
    "boot_id",
    "ack_sequence",
    "ack_hashes",
    "accepted_schema_versions",
    "receiver_time_utc",
    "clock_offset_hint_ms",
    "flow_control",
    "advisory",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "hcs.miner.ack.v1"
    },
    "receiver_id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable receiver instance identifier"
    },
    "device_id": {
      "type": "string",
      "format": "uuid",
      "description": "Device identifier from pairing"
    },
    "boot_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$",
      "description": "Boot identifier from the batch"
    },
    "ack_sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Highest sequence number durably committed. Device may release all events <= this sequence."
    },
    "ack_hashes": {
      "type": "array",
      "description": "Array of event_id values that were successfully committed, in order. Allows device to verify exact acceptance.",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$"
      }
    },
    "accepted_schema_versions": {
      "type": "array",
      "description": "Schema versions the receiver currently accepts for this device",
      "items": {
        "type": "string",
        "pattern": "^hcs\\.miner\\.event\\.v\\d+$"
      },
      "minItems": 1
    },
    "receiver_time_utc": {
      "type": "string",
      "format": "date-time",
      "description": "Receiver's current wall-clock time for clock sync"
    },
    "clock_offset_hint_ms": {
      "type": "integer",
      "description": "Signed offset in milliseconds: receiver_time - device_time. Device may use this to improve wall-clock quality.",
      "minimum": -3600000,
      "maximum": 3600000
    },
    "flow_control": {
      "type": "object",
      "required": ["max_batch_bytes", "max_events_per_batch", "max_pending_bytes"],
      "additionalProperties": false,
      "properties": {
        "max_batch_bytes": {
          "type": "integer",
          "minimum": 1024,
          "description": "Maximum batch payload size in bytes"
        },
        "max_events_per_batch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum events per batch"
        },
        "max_pending_bytes": {
          "type": "integer",
          "minimum": 10240,
          "description": "Maximum unacknowledged bytes the receiver will buffer per device"
        }
      }
    },
    "advisory": {
      "type": ["object", "null"],
      "description": "Optional signed advisory policy from HSCL1. Null if none.",
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "type": "string",
          "description": "Version/hash of the advisory policy"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "value", "confidence"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": ["frequency_hz", "voltage_mv", "power_limit_w", "fan_min_pwm", "thermal_target_c"]
              },
              "value": {
                "type": "number"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "expires_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[a-f0-9]{128}$",
          "description": "Ed25519 signature of the policy by HSCL1 operator key (64 bytes = 128 hex chars)"
        }
      }
    },
    "pause_requested": {
      "type": "boolean",
      "default": false,
      "description": "If true, device should pause mining (safety/operational reason). Requires explicit operator action to resume."
    },
    "revoke_requested": {
      "type": "boolean",
      "default": false,
      "description": "If true, pairing is revoked. Device must re-pair before further uploads."
    },
    "integrity": {
      "type": "object",
      "required": ["body_sha256", "signature"],
      "additionalProperties": false,
      "properties": {
        "body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the canonical ACK JSON (excluding this integrity field)"
        },
        "signature": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "HMAC-SHA-256 using per-device key (same as event auth, 32 bytes = 64 hex chars)"
        }
      }
    }
  }
}